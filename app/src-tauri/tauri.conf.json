{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STAR",
  "version": "3.0.20",
  "identifier": "io.github.sepehrsardooeinasab.steamautounlocker",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "category": "Utility",
    "shortDescription": "Steam Timed Achievement Replayer: replay a real player's achievement timeline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
