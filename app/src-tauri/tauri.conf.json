{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Auto Unlocker",
  "version": "1.0.0",
  "identifier": "io.github.sepehrsardooeinasab.steamautounlocker",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Replay a real player's Steam achievement timeline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
